# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- Локальное состояние пользователя ---
# SPEC §3.3: обязательные продукты, оценки магазинов, бюджет, флаг кандидатов.
# DECISIONS.md Р-4: SQLite держит настройки, пополнения словарей, подтверждения
# правил probable и food_candidate, позже — состояние алертов.
# Всё это живёт у каждого пользователя своё и в репозиторий не попадает.
*.db
*.sqlite
*.sqlite3
*-journal
*-wal
*-shm
settings.local.json

# --- Принятые выгрузки ФНС ---
# data/inbox/ — сырые выгрузки как пришли (agent/intake.py). Это настоящие чеки
# пользователя за периоды после эталонного датасета: у каждого свои, и в общий
# репозиторий им нельзя. Эталон data/receipts.json — наоборот, коммитится: см.
# оговорку в конце файла.
data/inbox/

# --- Рабочие выгрузки очередей на пополнение ---
# Вычисляются из данных и устаревают при первом же пополнении конфигов.
# Держать их в истории значит хранить заведомо неверный ответ.
zadacha-*.csv
ochered-*.csv

# --- Секреты ---
# Ключ модели и токен бота — только в переменных окружения площадки (Р-5).
.env
*.key

# --- macOS ---
.DS_Store

# ВАЖНО: data/receipts.json НЕ игнорируется. Владелец решил публиковать датасет
# вместе с кодом (README, «Статус данных»): его можно коммитить и разворачивать
# на публичном хостинге, отдельного обезличенного варианта не делаем.

# журнал хуков Claude Code
.claude/hooks.log
